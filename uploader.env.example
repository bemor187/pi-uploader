# /etc/uploader.env (same file on all four Pis; setup.sh creates it)
# API_TOKEN: what Grokbot / Claude Code send as "Authorization: Bearer ..."
API_TOKEN=change-me
# LANE_TOKEN: brain -> lane auth; must match on brain and every lane
LANE_TOKEN=change-me-too

# brain only: lane URLs over Tailscale MagicDNS
LANE_TIKTOK=http://tiktok:8100
LANE_INSTA=http://insta:8100
LANE_CLAPPER=http://clapper:8100
BRAIN_DATA=/var/lib/uploader
LANE_TIMEOUT=1800

# browser lanes
HEADLESS=1
# CHROMIUM_PATH=/usr/bin/chromium   # set automatically if Playwright's Chromium can't install
PROCESS_TIMEOUT=900
INSTA_ORIGINAL_CROP=1
# TIKTOK_VISIBILITY=Everyone

# clapper lane
CLAPPER_PACKAGE=com.newsclapper.video
# ADB_SERIAL=

# overseer only
# TASK_TOKEN: what you send to POST http://overseer:8200/task (setup.sh generates it)
TASK_TOKEN=change-me-three
# Ollama agents in routing priority: name=ollama:URL|model  (model optional -> first pulled model)
AGENTS=msi=ollama:http://msi:11434|qwen3:14b,macbook=ollama:http://macbook:11434,local=ollama:http://127.0.0.1:11434|qwen2.5:1.5b
BRAIN_URL=http://brain
# ntfy topic for alerts, e.g. https://ntfy.sh/some-long-random-topic (empty = log only)
ALERT_URL=
MONITOR_INTERVAL=60
OLLAMA_MODEL=qwen2.5:1.5b
