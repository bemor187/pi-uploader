# /etc/uploader.env (setup.sh creates it on every Pi; each role reads only its own section.
# web uses it only for the optional dashboard tokens below)
# API_TOKEN: what Grokbot / Claude Code send as "Authorization: Bearer ..."
API_TOKEN=change-me
# LANE_TOKEN: brain -> lane auth; must match on brain and every lane
LANE_TOKEN=change-me-too

# brain only: lane URLs over Tailscale MagicDNS
LANE_TIKTOK=http://tiktok:8100
LANE_INSTA=http://insta:8100
LANE_CLAPPER=http://clapper:8100
BRAIN_DATA=/var/lib/uploader
LANE_TIMEOUT=1800

# browser lanes
HEADLESS=1
# CHROMIUM_PATH=/usr/bin/chromium   # set automatically if Playwright's Chromium can't install
PROCESS_TIMEOUT=900
INSTA_ORIGINAL_CROP=1
# TIKTOK_VISIBILITY=Everyone   # or Friends, Only you (lane refuses to post if it cannot confirm the choice)

# clapper lane
CLAPPER_PACKAGE=com.newsclapper.video
# ADB_SERIAL=

# overseer only
# TASK_TOKEN: what you send to POST http://overseer:8200/task (setup.sh generates it)
TASK_TOKEN=change-me-three
# agents in routing priority: name=kind:URL|model  (kind: ollama, or openai = OpenAI-compatible: llama.cpp, LM Studio, vLLM; model optional -> first listed)
AGENTS=msi=ollama:http://msi:11434|qwen3:14b,macbook=ollama:http://macbook:11434,local=ollama:http://127.0.0.1:11434|qwen2.5:1.5b
BRAIN_URL=http://brain
# other hosts to watch: name=URL (any HTTP status < 400 = up)
SITES=web=http://web/health
# ntfy topic for alerts, e.g. https://ntfy.sh/some-long-random-topic (empty = log only)
ALERT_URL=
MONITOR_INTERVAL=60
# fleet (SSH as the Pi user over Tailscale SSH): host=unit+unit, one per Pi
FLEET=brain=uploader-brain,tiktok=uploader-lane@tiktok,insta=uploader-lane@insta,clapper=uploader-lane@clapper,web=nginx,overseer=overseer+ollama
FLEET_INTERVAL=300
# hours between lane /check calls (opens the lane's browser ~1 min; brain re-queues jobs meanwhile)
LOGIN_CHECK_H=6
DISK_WARN_PCT=90
TEMP_WARN_C=80
# 1 = restart a role whose health is down while its Pi still answers SSH (max once/hour each)
AUTO_RESTART=0
OLLAMA_MODEL=qwen2.5:1.5b

# web only (all optional; see README 4c). On web, API_TOKEN / TASK_TOKEN above = brain's / overseer's,
# so the dashboard can read /jobs and /fleet (GET only, injected by nginx, never sent to the browser).
# HIVE_TOKEN: GitHub fine-grained token, read-only Contents on bemor187/hive-brain (hive panel)
# HIVE_TOKEN=
# WEB_TAILNET=tail85ba4a.ts.net   # only if tailscale auto-detect fails
