# /etc/uploader.env (setup.sh creates it on every Pi; each role reads only its own section.
# web and postiz don't use it: postiz keeps its settings in /opt/postiz/.env)
# API_TOKEN: what Grokbot / Claude Code send as "Authorization: Bearer ..."
API_TOKEN=change-me
# LANE_TOKEN: brain -> lane auth; must match on brain and every lane
LANE_TOKEN=change-me-too

# brain only: lane URLs over Tailscale MagicDNS
LANE_TIKTOK=http://tiktok:8100
LANE_INSTA=http://insta:8100
LANE_CLAPPER=http://clapper:8100

# brain only: platforms posted through Postiz instead of a lane (empty = all lanes)
POSTIZ_PLATFORMS=tiktok,insta
POSTIZ_API=http://postiz/api/public/v1
# Postiz -> Settings -> Developers / Public API
POSTIZ_API_KEY=
# channel ids from Postiz; leave empty to auto-pick the only connected TikTok / Instagram channel
POSTIZ_TIKTOK_ID=
POSTIZ_INSTA_ID=
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
# DIRECT_POST publishes; UPLOAD drops it in the TikTok app inbox to finish by hand
TIKTOK_POSTING=DIRECT_POST
POSTIZ_POLL=300
BRAIN_DATA=/var/lib/uploader
LANE_TIMEOUT=1800

# browser lanes
HEADLESS=1
# CHROMIUM_PATH=/usr/bin/chromium   # set automatically if Playwright's Chromium can't install
PROCESS_TIMEOUT=900
INSTA_ORIGINAL_CROP=1
# TIKTOK_VISIBILITY=Everyone

# clapper lane
CLAPPER_PACKAGE=com.newsclapper.video
# ADB_SERIAL=

# overseer only
# TASK_TOKEN: what you send to POST http://overseer:8200/task (setup.sh generates it)
TASK_TOKEN=change-me-three
# Ollama agents in routing priority: name=ollama:URL|model  (model optional -> first pulled model)
AGENTS=msi=ollama:http://msi:11434|qwen3:14b,macbook=ollama:http://macbook:11434,local=ollama:http://127.0.0.1:11434|qwen2.5:1.5b
BRAIN_URL=http://brain
# other hosts to watch: name=URL (any HTTP status < 400 = up)
SITES=web=http://web/health,postiz=http://postiz/
# ntfy topic for alerts, e.g. https://ntfy.sh/some-long-random-topic (empty = log only)
ALERT_URL=
MONITOR_INTERVAL=60
# lane Pis to watch (tiktok/insta post through Postiz now)
MONITOR_LANES=clapper
OLLAMA_MODEL=qwen2.5:1.5b
